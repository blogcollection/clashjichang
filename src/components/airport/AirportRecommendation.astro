---
import type { RecommendationContext } from '../../lib/airports/types';
import { getAirportRecommendations } from '../../lib/airports/recommendations';

interface Props {
  context?: RecommendationContext;
  title?: string;
  description?: string;
}

const {
  context = 'clash',
  title,
  description
} = Astro.props;

const airports = getAirportRecommendations(context, 3);

const contextTitles: Record<RecommendationContext, { title: string; desc: string }> = {
  cheap: {
    title: '低预算套餐参考',
    desc: '按当前资料中公开的最低月付或年付价格排序展示，供低预算用户参考。购买前请核对服务商实时价格。'
  },
  beginner: {
    title: '入门价格较低的服务参考',
    desc: '展示基础月付门槛较低或客户端支持说明较明确的机场，不代表本站对其售后或体验做出保证。'
  },
  streaming: {
    title: '流媒体字段已提及的服务',
    desc: '展示当前资料中明确提到 Netflix、Disney+ 等流媒体服务支持的机场。实际可用性以当前节点状态与服务商说明为准。'
  },
  ai: {
    title: 'AI 服务字段已提及的服务',
    desc: '展示当前资料中明确提到 ChatGPT、Claude、Gemini 等 AI 服务支持的机场。'
  },
  clash: {
    title: '明确提及 Clash 兼容的服务',
    desc: '优先展示当前资料中明确提到 Clash、Mihomo 或相关客户端支持的机场。'
  },
  largeTraffic: {
    title: '大流量套餐服务参考',
    desc: '展示当前资料中包含较大流量规格套餐的机场，具体流量重置与计费规则以服务商页面为准。'
  },
  oneTime: {
    title: '不限时流量包服务参考',
    desc: '展示当前资料中包含一次性或不限时计费流量包的机场，适合低频备用需求。'
  },
  multiDevice: {
    title: '标注多设备不限的服务参考',
    desc: '展示当前资料中标注不限制在线客户端或并发设备数量的机场。'
  },
  iepl: {
    title: '标注 IEPL 线路的服务参考',
    desc: '展示当前资料中标注 IEPL 线路的机场。线路类型来自服务商或整理资料，实际体验会受到本地运营商、地区和时段影响。'
  },
  iplc: {
    title: '标注 IPLC 专线的服务参考',
    desc: '展示当前资料中标注 IPLC 专线线路的机场。专线信息整理自服务商资料，实际连通性与延迟以本地网络测试为准。'
  }
};

const currentContext = contextTitles[context] || contextTitles.clash;
const heading = title || currentContext.title;
const subText = description || currentContext.desc;
---

<div class="my-8 rounded-lg border border-slate-200 bg-slate-50/80 p-5 not-prose">
  <div class="flex items-center justify-between border-b border-slate-200 pb-3">
    <div>
      <h3 class="text-base font-bold text-slate-900">{heading}</h3>
      <p class="mt-0.5 text-xs text-slate-500">{subText}</p>
    </div>
    <a href="/recommend/" class="hidden sm:inline-block text-xs font-semibold text-brand-600 hover:text-brand-700">
      查看更多推荐 &rarr;
    </a>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
    {airports.map((airport) => {
      let priceText = '价格以官网为准';
      if (airport.pricing.monthly !== null) {
        priceText = `¥${airport.pricing.monthly}/月起`;
      } else if (airport.pricing.annual !== null) {
        priceText = `¥${airport.pricing.annual}/年起`;
      }

      return (
        <div class="flex flex-col justify-between rounded border border-slate-200 bg-white p-3.5 shadow-sm transition hover:border-slate-300">
          <div>
            <div class="flex items-start justify-between gap-1">
              <h4 class="text-sm font-bold text-slate-900">
                <a href={`/airports/${airport.slug}/`} class="hover:text-brand-600 transition">
                  {airport.name}
                </a>
              </h4>
              <span class="text-xs font-bold text-brand-600 whitespace-nowrap">{priceText}</span>
            </div>

            <p class="mt-1 text-[11px] text-slate-500 font-mono line-clamp-1">{airport.architecture || '线路资料暂缺'}</p>
            <p class="mt-2 text-xs text-slate-600 line-clamp-2 leading-relaxed">{airport.summary}</p>
          </div>

          <div class="mt-3 flex items-center gap-2 border-t border-slate-100 pt-2.5">
            <a
              href={`/airports/${airport.slug}/`}
              class="flex-1 rounded border border-slate-200 bg-slate-50 py-1 text-center text-xs font-medium text-slate-700 hover:bg-slate-100 transition"
            >
              测评详情
            </a>
            <a
              href={airport.ctaUrl}
              target="_blank"
              rel="sponsored nofollow noopener noreferrer"
              class="flex-1 rounded bg-slate-900 py-1 text-center text-xs font-medium text-white hover:bg-slate-800 transition"
            >
              {airport.ctaText}
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <div class="mt-3 flex items-center justify-between text-[11px] text-slate-500">
    <span>注：推荐基于机场客观参数与场景匹配，非商业付费排名</span>
    <a href="/airports/" class="font-medium text-slate-700 hover:underline">
      浏览全部 31 家机场完整数据库 &rarr;
    </a>
  </div>
</div>
