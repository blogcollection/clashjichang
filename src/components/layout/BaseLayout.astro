---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../../styles/global.css';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FAQItem[];
}

const {
  title,
  description,
  keywords = [
    'Clash机场',
    'Clash机场推荐',
    'Clash节点',
    'Clash订阅',
    'Clash客户端',
    'Clash Verge',
    'Mihomo',
    '机场推荐',
    '节点测速',
    'IPLC专线'
  ],
  canonicalUrl,
  ogType = 'website',
  publishedTime,
  breadcrumbs = [],
  faqs = []
} = Astro.props;

const siteUrl = 'https://clashjichang.sbs';
const currentPath = Astro.url.pathname;
const fullCanonical = canonicalUrl || `${siteUrl}${currentPath.endsWith('/') ? currentPath : currentPath + '/'}`;

// Schemas
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Clash机场',
  'url': siteUrl,
  'description': '整理 Clash 机场、节点、订阅和客户端教程，帮助你了解不同机场套餐并解决 Clash 使用问题。',
  'inLanguage': 'zh-CN'
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Clash机场',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`
};

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbs.map((b, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'name': b.name,
    'item': b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}`
  }))
} : null;

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.a
    }
  }))
} : null;

const articleSchema = ogType === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  'headline': title,
  'description': description,
  'inLanguage': 'zh-CN',
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': fullCanonical
  },
  'datePublished': publishedTime || '2026-09-28',
  'author': {
    '@type': 'Organization',
    'name': 'Clash机场编辑部'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Clash机场',
    'logo': {
      '@type': 'ImageObject',
      'url': `${siteUrl}/favicon.svg`
    }
  }
} : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:site_name" content="Clash机场" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-slate-50 text-slate-850 antialiased selection:bg-brand-100 selection:text-brand-900">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
