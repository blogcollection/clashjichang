---
const navItems = [
  { label: '首页', href: '/' },
  { label: '机场推荐', href: '/recommend/' },
  { label: '机场大全', href: '/airports/' },
  { label: '机场对比', href: '/compare/' },
  { label: 'Clash教程', href: '/tutorials/' },
  { label: '常见问题', href: '/problems/' }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 text-slate-900 transition-colors hover:text-brand-600">
        <div class="flex h-8 w-8 items-center justify-center rounded border border-slate-300 bg-slate-900 text-white font-bold text-base shadow-sm">
          C
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-bold tracking-tight text-slate-900 leading-tight">Clash机场</span>
          <span class="text-[10px] text-slate-500 font-medium">clashjichang.sbs</span>
        </div>
      </a>
      <span class="hidden rounded border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600 sm:inline-block">
        2026 机场数据库
      </span>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3 py-1.5 rounded transition-colors ${
              isActive
                ? 'bg-slate-100 text-slate-900 font-semibold'
                : 'hover:bg-slate-50 hover:text-slate-900'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <a
        href="/recommend/"
        class="hidden sm:inline-flex items-center justify-center rounded border border-brand-600 bg-brand-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-brand-700"
      >
        热门机场推荐
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="切换菜单"
        class="inline-flex md:hidden items-center justify-center rounded p-2 text-slate-700 hover:bg-slate-100"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block rounded px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-2">
      <a
        href="/recommend/"
        class="flex w-full items-center justify-center rounded bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
      >
        热门机场推荐
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
