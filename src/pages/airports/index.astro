---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AirportCard from '../../components/airport/AirportCard.astro';
import AirportTable from '../../components/airport/AirportTable.astro';
import { getAllAirports } from '../../lib/airports/recommendations';

const airports = getAllAirports();

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场大全', url: '/airports/' }
];
---

<BaseLayout
  title="Clash机场大全｜节点、套餐与机场资料整理"
  description="汇总收录 31 家优质 Clash 机场资料，包含 IPLC/IEPL 专线、价格、节点地区、流媒体与 AI 解锁情况，支持多维度筛选。"
  breadcrumbs={breadcrumbs}
>
  <div class="border-b border-slate-200 bg-white py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1">
          <li><a href="/" class="hover:text-slate-900 transition">首页</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="font-semibold text-slate-900">机场大全</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Clash机场大全
        </h1>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          收录 31 家真实运营的 Clash 机场资料。所有技术架构、节点地区、套餐定价与解锁支持均由原始数据严格核验，无人工虚构跑分与绝对排名，提供真实客观的横向选型参考。
        </p>
      </div>

      <!-- Quick Category Nav -->
      <div class="mt-6 flex flex-wrap items-center gap-2 pt-4 border-t border-slate-100 text-xs">
        <span class="text-slate-500 font-medium">快速直达分类：</span>
        <a href="/recommend/#cheap" class="rounded bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 transition">便宜机场</a>
        <a href="/recommend/#streaming" class="rounded bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 transition">流媒体解锁</a>
        <a href="/recommend/#ai" class="rounded bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 transition">ChatGPT/AI</a>
        <a href="/recommend/#largeTraffic" class="rounded bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 transition">大流量机场</a>
        <a href="/recommend/#oneTime" class="rounded bg-slate-100 px-2.5 py-1 text-slate-700 hover:bg-slate-200 transition">不限时流量</a>
        <a href="/compare/" class="rounded bg-brand-50 text-brand-700 font-semibold px-2.5 py-1 hover:bg-brand-100 transition">参数矩阵对比</a>
      </div>
    </div>
  </div>

  <!-- Airport Cards Grid -->
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-slate-900">
        全部机场列表 ({airports.length})
      </h2>
      <span class="text-xs text-slate-500">按内部收录顺序展示</span>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {airports.map(airport => (
        <AirportCard airport={airport} />
      ))}
    </div>

    <!-- Full Database Table -->
    <div class="mt-16">
      <div class="mb-4">
        <h2 class="text-xl font-bold text-slate-900">全库参数一览表</h2>
        <p class="text-xs text-slate-500 mt-1">横向对比全部 31 家服务商价格与配置</p>
      </div>
      <AirportTable airports={airports} />
    </div>
  </div>
</BaseLayout>
