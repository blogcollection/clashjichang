---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts')).filter(post => !post.data.draft);
const clashPosts = allPosts.filter(p => 
  p.data.category === 'tutorial' || 
  p.data.category === 'concept' || 
  p.slug.includes('clash')
);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: 'Clash专区', url: '/clash/' }
];
---

<BaseLayout
  title="Clash专区｜Clash核心概念、内核演进与生态索引 - Clash机场"
  description="深度梳理 Clash、Clash.Meta 与 Mihomo 内核生态技术演进。汇总主流客户端安装使用说明与规则分流体系。"
  breadcrumbs={breadcrumbs}
>
  <div class="border-b border-slate-200 bg-white py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1">
          <li><a href="/" class="hover:text-slate-900 transition">首页</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="font-semibold text-slate-900">Clash专区</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Clash 知识体系与生态索引
        </h1>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          深入了解现代规则代理的核心基石：从内核机制、分流策略组设计到多端客户端的日常维护。
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {clashPosts.map(post => (
        <article class="rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-300 hover:shadow-sm transition flex flex-col justify-between">
          <div>
            <span class="rounded bg-brand-50 text-brand-700 text-[11px] font-medium px-2 py-0.5">
              {post.data.tags[0] || (post.data.category === 'tutorial' ? '操作教程' : '技术科普')}
            </span>
            <h2 class="text-base font-bold text-slate-900 mt-2">
              <a href={`/posts/${post.slug}/`} class="hover:text-brand-600 transition">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-xs text-slate-600 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400">{post.data.pubDate.toISOString().split('T')[0]}</span>
            <a href={`/posts/${post.slug}/`} class="text-brand-600 font-semibold hover:underline">
              阅读全文 &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
