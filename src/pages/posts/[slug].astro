---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AirportRecommendation from '../../components/airport/AirportRecommendation.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(post => !post.data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const publishedDate = post.data.pubDate.toISOString().slice(0, 10);

// Related posts
const allPosts = (await getCollection('posts')).filter(post => !post.data.draft);
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && (p.data.category === post.data.category || p.data.recommendationContext === post.data.recommendationContext))
  .slice(0, 3);

// Breadcrumbs
const categoryNames: Record<string, string> = {
  airport: '机场评测',
  client: '客户端教程',
  subscription: '订阅指南',
  node: '节点知识',
  troubleshoot: '故障排错',
  tutorial: 'Clash教程',
  concept: '原理解析',
  selection: '机场选购'
};

const categoryHref: Record<string, string> = {
  airport: '/airports/',
  client: '/tutorials/',
  subscription: '/tutorials/',
  node: '/tutorials/',
  troubleshoot: '/problems/',
  tutorial: '/tutorials/',
  concept: '/tutorials/',
  selection: '/recommend/'
};

const catName = categoryNames[post.data.category] || 'Clash教程';
const catHref = categoryHref[post.data.category] || '/tutorials/';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: catName, url: catHref },
  { name: post.data.title, url: `/posts/${post.slug}/` }
];
---

<BaseLayout
  title={`${post.data.title} - Clash机场`}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  breadcrumbs={breadcrumbs}
  faqs={post.data.faq}
>
  <div class="border-b border-slate-200 bg-white py-8 sm:py-12">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Nav -->
      <nav class="flex text-xs text-slate-500 mb-4" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1">
          <li><a href="/" class="hover:text-slate-900 transition">首页</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href={catHref} class="hover:text-slate-900 transition">{catName}</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="font-semibold text-slate-900 truncate max-w-[200px] sm:max-w-none">{post.data.title}</li>
        </ol>
      </nav>

      <div class="flex items-center gap-2 mb-3">
        <span class="rounded bg-brand-50 text-brand-700 text-xs px-2.5 py-0.5 font-medium">
          {catName}
        </span>
        <span class="text-xs text-slate-400">发布于 {publishedDate}</span>
        <span class="text-xs text-slate-400">•</span>
        <span class="text-xs text-slate-400">Clash机场指南</span>
      </div>

      <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl md:text-4xl leading-tight">
        {post.data.title}
      </h1>

      <p class="mt-3 text-sm text-slate-600 leading-relaxed border-l-2 border-brand-500 pl-3 italic">
        {post.data.description}
      </p>

      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5 pt-3 border-t border-slate-100">
          {post.data.tags.map(tag => (
            <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] text-slate-600">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Main Article Body -->
    <article class="prose max-w-none">
      <Content />
    </article>

    <!-- Contextual Airport Recommendation (Hard Requirement) -->
    <div class="my-10">
      <div class="mb-3 rounded-lg border border-brand-200 bg-brand-50/70 p-4 text-xs text-brand-950 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-brand-600 text-white font-bold text-xs flex-shrink-0">
            ✓
          </span>
          <p class="font-medium leading-relaxed">
            配置好 Clash 后，你需要一个稳定的机场订阅。以下是经过整理的服务商：
          </p>
        </div>
        <a href="/airports/" class="text-brand-700 font-bold hover:underline whitespace-nowrap self-end sm:self-center">
          查看全部 31 家机场 &rarr;
        </a>
      </div>
      <AirportRecommendation context={post.data.recommendationContext} />
    </div>

    <!-- Article FAQ Section -->
    {post.data.faq && post.data.faq.length > 0 && (
      <section class="mt-12 rounded-lg border border-slate-200 bg-white p-6 sm:p-8">
        <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2">
          <span>本文常见问题解答 (FAQ)</span>
          <span class="text-xs font-normal text-slate-400">• 答疑参考</span>
        </h2>

        <div class="mt-4 space-y-4">
          {post.data.faq.map(item => (
            <div class="rounded border border-slate-100 bg-slate-50/70 p-4">
              <h3 class="text-sm font-bold text-slate-900">{item.q}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-600">{item.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <div class="mt-12 border-t border-slate-200 pt-8">
        <h2 class="text-base font-bold text-slate-900 mb-4">相关延伸阅读</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedPosts.map(rel => (
            <a
              href={`/posts/${rel.slug}/`}
              class="block rounded-lg border border-slate-200 bg-white p-4 hover:border-slate-300 hover:shadow-sm transition"
            >
              <h3 class="text-xs font-bold text-slate-900 line-clamp-2 hover:text-brand-600 transition">
                {rel.data.title}
              </h3>
              <p class="mt-1.5 text-[11px] text-slate-500 line-clamp-2 leading-relaxed">
                {rel.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Bottom Return Nav -->
    <div class="mt-10 flex items-center justify-between border-t border-slate-100 pt-6 text-xs">
      <a href={catHref} class="font-semibold text-slate-600 hover:text-slate-900 transition">
        &larr; 返回{catName}
      </a>
      <a href="/airports/" class="font-semibold text-brand-600 hover:text-brand-700 transition">
        查看 Clash 机场数据库 &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
