---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AirportRecommendation from '../../components/airport/AirportRecommendation.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts')).filter(post => !post.data.draft);
const problemPosts = allPosts.filter(p => p.data.category === 'troubleshoot');

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '常见问题与排障', url: '/problems/' }
];
---

<BaseLayout
  title="Clash常见问题排错手册｜连上无网、超时与报错速查 - Clash机场"
  description="针对 Clash 节点全部超时、连上打不开网页、系统代理无法打开、DNS 泄漏与订阅下载失败等顽疾的高频故障诊断与解决方案。"
  breadcrumbs={breadcrumbs}
>
  <div class="border-b border-slate-200 bg-white py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1">
          <li><a href="/" class="hover:text-slate-900 transition">首页</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="font-semibold text-slate-900">故障排查</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Clash 故障排查与常见问题排错
        </h1>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          整理 99% 用户日常遇到的各种报错与网络连通性异常，从配置语法、端口占用、系统时间到防火墙阻断，提供行之有效的手动修复步骤。
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-12">
    <!-- Problems Grid -->
    <div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {problemPosts.map(post => (
          <article class="rounded-lg border border-slate-200 bg-white p-6 hover:border-slate-300 hover:shadow-sm transition flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="rounded bg-rose-50 text-rose-700 border border-rose-200 text-xs px-2 py-0.5 font-medium">
                  排错诊断
                </span>
              </div>
              <h2 class="text-base font-bold text-slate-900 leading-snug">
                <a href={`/posts/${post.slug}/`} class="hover:text-brand-600 transition">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-xs text-slate-600 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400">实用排障</span>
              <a href={`/posts/${post.slug}/`} class="text-rose-600 font-semibold hover:underline">
                查看解决指南 &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Fallback Airport Recommendation if node issue -->
    <div>
      <AirportRecommendation
        context="iepl"
        title="频繁遇到节点超时？考虑备选专线服务"
        description="若排查本地配置无误后依然存在断连，多为当前服务商公网隧道受阻。以下为具备独立专线入口的机场服务商参考："
      />
    </div>
  </div>
</BaseLayout>
