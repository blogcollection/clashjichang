---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AirportTable from '../../components/airport/AirportTable.astro';
import { getAllAirports } from '../../lib/airports/recommendations';

const airports = getAllAirports();

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场对比', url: '/compare/' }
];
---

<BaseLayout
  title="Clash机场对比｜31家机场参数、价格与节点完整矩阵"
  description="31 家真实 Clash 机场深度横向对比。涵盖线路架构（IPLC/IEPL/BGP）、月付与年付门槛、节点覆盖国家、流媒体与 AI 解锁支持、设备并发限制。"
  breadcrumbs={breadcrumbs}
>
  <div class="border-b border-slate-200 bg-white py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1">
          <li><a href="/" class="hover:text-slate-900 transition">首页</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="font-semibold text-slate-900">机场对比</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Clash 机场参数与套餐全量对比
        </h1>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          基于统一验证标准建立的 31 家服务商横向比对矩阵。支持直观对比专线类型、真实最低入场价格、节点地区数量及流媒体/AI支持。
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 space-y-12">
    <!-- Comparison Table -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-bold text-slate-900">全量对比矩阵 (共 31 家)</h2>
        <span class="text-xs text-slate-500">提示：表格支持左右横向滚动查看</span>
      </div>
      <AirportTable airports={airports} />
    </div>

    <!-- Comparison Guide -->
    <div class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8">
      <h2 class="text-xl font-bold text-slate-900 mb-4">
        如何看懂对比参数进行精准决策？
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-600 leading-relaxed">
        <div>
          <h3 class="font-bold text-slate-900 text-sm mb-1.5">1. 线路架构优先级</h3>
          <p>
            线路名称只反映服务商提供的资料字段，并不构成统一性能排序。<br />
            延迟、丢包、可用性和实际路由会随网络环境变化，建议按自己的网络与短周期套餐测试。
          </p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 text-sm mb-1.5">2. 资费与付费周期</h3>
          <p>
            不要只看年付总价。注意计算<strong>折合单月成本</strong>。首次购买任意机场请始终<strong>优先按月支付</strong>，实测满足自己宽带运营商与设备需求后再续期。
          </p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 text-sm mb-1.5">3. 节点与解锁支持</h3>
          <p>
            常规浏览重点看香港、日本、新加坡等亚太近距离低延迟节点；如果有固定看美区 Netflix 或使用 ChatGPT 需求，重点关注是否有专门的原生 IP 标记。
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
