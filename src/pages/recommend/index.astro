---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import AirportCard from '../../components/airport/AirportCard.astro';
import { getAirportRecommendations } from '../../lib/airports/recommendations';

const beginnerAirports = getAirportRecommendations('beginner', 4);
const cheapAirports = getAirportRecommendations('cheap', 4);
const streamingAirports = getAirportRecommendations('streaming', 4);
const aiAirports = getAirportRecommendations('ai', 4);
const largeTrafficAirports = getAirportRecommendations('largeTraffic', 4);
const oneTimeAirports = getAirportRecommendations('oneTime', 4);
const multiDeviceAirports = getAirportRecommendations('multiDevice', 4);
const ieplAirports = getAirportRecommendations('iepl', 4);
const iplcAirports = getAirportRecommendations('iplc', 4);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '机场推荐', url: '/recommend/' }
];
---

<BaseLayout
  title="Clash机场推荐｜如何选择适合自己的Clash机场"
  description="基于真实数据与实际业务场景的 Clash 机场推荐指南。覆盖新手入门、平价低预算、4K流媒体、ChatGPT/AI生产力、不限时流量与企业级专线。"
  breadcrumbs={breadcrumbs}
>
  <div class="border-b border-slate-200 bg-white py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1">
          <li><a href="/" class="hover:text-slate-900 transition">首页</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="font-semibold text-slate-900">机场推荐</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
          Clash机场场景化推荐指南
        </h1>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          不存在放之四海而皆准的“第一名机场”。根据你的实际使用用途（日常轻度办公、追求极致晚高峰低延迟、海外 4K 流媒体追剧还是高频调用 AI 工具），选择符合真实技术条件的机场才是最优解。
        </p>
      </div>

      <!-- Jump Navigation -->
      <div class="mt-6 flex flex-wrap gap-2 text-xs">
        <span class="text-slate-400 self-center">定位锚点：</span>
        <a href="#beginner" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">新手入门</a>
        <a href="#cheap" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">低预算平价</a>
        <a href="#streaming" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">流媒体追剧</a>
        <a href="#ai" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">ChatGPT/AI</a>
        <a href="#largeTraffic" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">大流量套餐</a>
        <a href="#oneTime" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">不限时流量</a>
        <a href="#multiDevice" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">多设备不限</a>
        <a href="#iepl" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">IEPL专线</a>
        <a href="#iplc" class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-slate-700 hover:bg-slate-100">IPLC专线</a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-16">
    <!-- 1. 入门价格较低 -->
    <section id="beginner">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>入门价格较低的 Clash 机场</span>
          <span class="rounded bg-brand-50 text-brand-700 text-xs px-2 py-0.5 font-normal">低门槛月付参考</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          展示基础月付门槛较低或客户端支持说明较明确的机场，供低门槛尝试或轻度使用用户参考。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {beginnerAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 2. 低预算平价 -->
    <section id="cheap">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>平价与低预算参考</span>
          <span class="rounded bg-emerald-50 text-emerald-700 text-xs px-2 py-0.5 font-normal">低入门价</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          根据当前核验的最低月付或年付价格排序展示，供预算有限用户比对参考。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {cheapAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 3. 流媒体支持 -->
    <section id="streaming">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>流媒体支持资料整理</span>
          <span class="rounded bg-purple-50 text-purple-700 text-xs px-2 py-0.5 font-normal">Netflix • Disney+</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          展示当前整理资料中明确标注支持 Netflix、Disney+ 等流媒体解锁的服务商。实际播放与连通性以本地网络及当前节点状态为准。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {streamingAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 4. AI工具支持 -->
    <section id="ai">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>AI 工具支持资料整理</span>
          <span class="rounded bg-blue-50 text-blue-700 text-xs px-2 py-0.5 font-normal">ChatGPT • Claude</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          展示当前整理资料中明确提及支持 ChatGPT、Claude、Gemini 等 AI 平台的服务商。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {aiAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 5. 大流量套餐 -->
    <section id="largeTraffic">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>大流量套餐机场参考</span>
          <span class="rounded bg-amber-50 text-amber-700 text-xs px-2 py-0.5 font-normal">500GB+ 套餐</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          展示当前资料中包含 500GB 至 1TB+ 等大流量规格套餐的机场，适合中高频用量需求。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {largeTrafficAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 6. 不限时流量包 -->
    <section id="oneTime">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>不限时按量计费流量包</span>
          <span class="rounded bg-teal-50 text-teal-700 text-xs px-2 py-0.5 font-normal">按量备用</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          展示包含一次性计费、不限时长按量套餐的机场，适合低频或备用网络场景。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {oneTimeAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 7. 多设备不限制 -->
    <section id="multiDevice">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>标注多设备不限的机场</span>
          <span class="rounded bg-indigo-50 text-indigo-700 text-xs px-2 py-0.5 font-normal">未设并发限制</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          展示当前资料中标注不限制同时连接客户端或设备数量的机场。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {multiDeviceAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 8. IEPL 专线 -->
    <section id="iepl">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>标注 IEPL 线路的机场</span>
          <span class="rounded bg-slate-100 text-slate-800 text-xs px-2 py-0.5 font-normal">IEPL 内网中转</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          IEPL 属于以太网专线或内网中转连接方案。此分类展示资料中标注 IEPL 线路的机场，实际延迟与稳定性以本地测速为准。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ieplAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>

    <!-- 9. IPLC 专线 -->
    <section id="iplc">
      <div class="border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span>标注 IPLC 专线的机场</span>
          <span class="rounded bg-rose-50 text-rose-700 text-xs px-2 py-0.5 font-normal">IPLC 专线连接</span>
        </h2>
        <p class="text-xs text-slate-600 mt-1">
          IPLC 属于点对点租用专线连接方案。此分类展示资料中标注 IPLC 专线的机场，具体可用性与资费以服务商页面为准。
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {iplcAirports.map(airport => (
          <AirportCard airport={airport} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
